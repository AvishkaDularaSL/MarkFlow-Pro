# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Security & Sessions
JWT_SECRET="watermark_super_secret_jwt_key_2026_change_in_production"
APP_ENV="development"

# Database Configuration (PostgreSQL / Internal Relational DB)
DB_HOST="localhost"
DB_PORT="5432"
DB_DATABASE="watermark_db"
DB_USERNAME="postgres"
DB_PASSWORD=""

# Storage & Cleanup Settings
TEMP_FILE_LIFETIME=3600
MAX_UPLOAD_SIZE=52428800
STORAGE_PATH="./storage"

