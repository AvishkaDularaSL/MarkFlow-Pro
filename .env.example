# ==========================================================
# MarkFlow Pro - Environment Configuration for cPanel & Local
# ==========================================================

# Application Port (Port 3000 is used by reverse proxy / cPanel Passenger)
PORT=3000
NODE_ENV=production

# Application URL
APP_URL=https://your-domain.com

# Security & Authentication Secrets
JWT_SECRET=markflow_super_secure_jwt_secret_key_change_in_production_2026

# ==========================================================
# MySQL Database Configuration (cPanel MySQL / Remote DB)
# ==========================================================
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_watermarkdb
DB_USERNAME=cpaneluser_wmuser
DB_PASSWORD=your_strong_cpanel_db_password
DB_PREFIX=wm_
DB_SSL=false
DB_CONNECTION_LIMIT=10

# ==========================================================
# Storage & Background Processing Limits
# ==========================================================
TEMP_FILE_LIFETIME=3600
MAX_UPLOAD_SIZE=52428800
DEFAULT_WEBP_QUALITY=80
AUTO_CLEANUP_INTERVAL=300
STORAGE_PATH=./storage

# Optional Gemini AI API Key
GEMINI_API_KEY=
